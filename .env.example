# Copy to .env for local use. On Render, set these as environment variables instead.
TOKEN=your-bot-token
YAPIN_CLIENT_ID=your-oauth-client-id   # YAPPER_CLIENT_ID also works
YAPIN_CLIENT_SECRET=your-oauth-client-secret
SESSION_SECRET=long-random-string
# BASE_URL=https://your-app.onrender.com   (Render sets this automatically; set it if you use a custom domain)
# OWNER_IDS=123,456                        (people who can manage every server the bot is in)
# MODBOT_DATA=/var/data/modbot_data.json
