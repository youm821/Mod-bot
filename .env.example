# Yapper bot token from Yapper > Settings > Developer > your bot > Token
TOKEN=your_yapper_bot_token

# Dashboard OAuth: create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DASHBOARD_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/auth/discord/callback

# Comma-separated Discord user IDs permitted to sign into the dashboard
DASHBOARD_ALLOWED_DISCORD_IDS=123456789012345678

# Generate a random secret of at least 32 characters
DASHBOARD_SECRET=replace_with_a_long_random_secret_of_32_chars_or_more


